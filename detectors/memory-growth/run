#!/bin/sh
# Runs the detector with a real python3 (3.7 or later, standard library only).
# On macOS /usr/bin/python3 is a shim that writes a cache outside TMPDIR, which a
# detector's sandbox refuses: the interpreter behind it is run directly instead.
here=$(cd "$(dirname "$0")" && pwd) || exit 1
for py in \
    "$(/usr/bin/xcode-select -p 2>/dev/null)/usr/bin/python3" \
    /Library/Developer/CommandLineTools/usr/bin/python3 \
    /opt/homebrew/bin/python3 \
    /usr/local/bin/python3 \
    "$(command -v python3 2>/dev/null)"; do
    if [ -x "$py" ] && [ "$py" != /usr/bin/python3 ]; then
        PYTHONDONTWRITEBYTECODE=1 exec "$py" -B -I "$here/detector.py" "$@"
    fi
done
[ -x /usr/bin/python3 ] && PYTHONDONTWRITEBYTECODE=1 exec /usr/bin/python3 -B -I "$here/detector.py" "$@"
echo "$(basename "$here"): no python3 found" >&2
exit 1
