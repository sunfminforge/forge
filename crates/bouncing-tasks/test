#!/bin/sh
# The fixture tests of this detector, against its binary: sh crates/bouncing-tasks/test,
# or cargo test, which names the binary it built in DETECTOR.
here=$(cd "$(dirname "$0")" && pwd) || exit 1
if [ -z "${DETECTOR:-}" ]; then
    cargo build --quiet --manifest-path "$here/Cargo.toml" || exit 1
    DETECTOR="${CARGO_TARGET_DIR:-$here/target}/debug/bouncing-tasks"
fi
export DETECTOR
dev=$(readlink /var/db/xcode_select_link 2>/dev/null)
fw=Library/Frameworks/Python3.framework/Versions/Current/bin/python3
for py in ${GUILD_PYTHON3:-} "$dev/$fw" \
    "/Library/Developer/CommandLineTools/$fw" \
    "/Applications/Xcode.app/Contents/Developer/$fw"; do
    [ -n "$py" ] && [ -x "$py" ] && exec "$py" -I -B "$here/test.py" "$@"
done
echo "$(basename "$here"): no python3 of a developer directory found" >&2
exit 1
